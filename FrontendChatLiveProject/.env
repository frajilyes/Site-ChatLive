# Copier ce fichier en .env. Aucune valeur secrete ici : tout ce qui
# commence par VITE_ est inclus tel quel dans le paquet envoye au
# navigateur.

# Adresse du BackendChatLiveProject : API REST et serveur Socket.IO
# partagent le meme port.
VITE_API_URL=http://localhost:4000

# Identifiant client OAuth 2.0 Google, celui du bouton « Continuer avec
# Google ». Meme valeur que GOOGLE_CLIENT_ID cote BackendChatLiveProject.
# A creer sur console.cloud.google.com (type « Application Web »), en
# declarant http://localhost:5173 dans les origines JavaScript
# autorisees. Laisse vide, les boutons Google restent inactifs.
VITE_GOOGLE_CLIENT_ID=248709346224-e2r7i9bd155u1af5ciharrramqcss7bo.apps.googleusercontent.com

# Adresse publique du site, protocole compris et sans barre oblique
# finale. Elle sert a tout ce qui doit etre absolu : URLs canoniques,
# sitemap.xml, robots.txt et apercus partages sur les reseaux sociaux.
#
# C'est la seule valeur a changer le jour de la mise en ligne. Absente,
# le site retombe sur https://chatlive.app (DEFAULT_ORIGIN dans
# src/lib/seo.ts) : les pages fonctionnent, mais elles se declarent
# toutes sous ce domaine-la.
VITE_SITE_URL=https://chatlive.app
