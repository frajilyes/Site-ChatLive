# Connexion Google (« Continuer avec Google »). Identifiant client OAuth
# 2.0 de type « Application Web » cree sur console.cloud.google.com, avec
# http://localhost:5173 dans les origines JavaScript autorisees. La meme
# valeur est recopiee dans FrontendChatLiveProject/.env (VITE_GOOGLE_CLIENT_ID).
# Aucun secret client n'est necessaire : le serveur ne fait que verifier
# la signature du jeton d'identite emis par Google.
GOOGLE_CLIENT_ID=248709346224-e2r7i9bd155u1af5ciharrramqcss7bo.apps.googleusercontent.com

# Envoi du code de confirmation d'inscription (SMTP Gmail).
# MAIL_PASS n'est PAS le mot de passe du compte Google mais un « mot de
# passe d'application » de 16 lettres : activez la validation en deux
# etapes puis creez-en un sur https://myaccount.google.com/apppasswords
# Laisser MAIL_USER/MAIL_PASS vides desactive l'envoi : le code s'affiche
# alors dans la console du serveur, ce qui suffit pour developper.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=frajilyespes@gmail.com
MAIL_PASS=buabafngzhiyqxso
MAIL_FROM="ChatLive <frajilyespes@gmail.com>"

# Duree de vie d'un code et delai entre deux envois.
VERIFICATION_TTL_MINUTES=15
VERIFICATION_RESEND_SECONDS=60
